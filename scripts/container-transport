#!/bin/sh
set -eu
# GARAGE_TRANSPORT_RUNTIME_DIR / GARAGE_TRANSPORT_CONTROL_GID exist only so tests can run this
# script unprivileged; the image never sets them (defaults are the fixed volume and group 1003).
export PIPEWIRE_RUNTIME_DIR=${GARAGE_TRANSPORT_RUNTIME_DIR:-/run/garage-audio/pipewire}
control_gid=${GARAGE_TRANSPORT_CONTROL_GID:-1003}
case $control_gid in
  ''|*[!0-9]*) echo "container-transport: GARAGE_TRANSPORT_CONTROL_GID must be numeric (got: $control_gid)" >&2; exit 1;;
esac
export PIPEWIRE_REMOTE=garage-pipewire
export XDG_RUNTIME_DIR=$PIPEWIRE_RUNTIME_DIR
export ALSA_CONFIG_PATH=/app/audio/asound.conf
mkdir -p "$PIPEWIRE_RUNTIME_DIR"
chmod 0770 "$PIPEWIRE_RUNTIME_DIR"
sock=$PIPEWIRE_RUNTIME_DIR/garage-pipewire
# The runtime directory is a persistent volume: after an unclean stop a stale socket and lock
# remain. This container is the volume's only PipeWire owner, so remove them BEFORE starting
# PipeWire; otherwise the readiness wait below would accept the stale file and PipeWire would
# later recreate the socket with its default 0755 mode, unreachable for the device worker.
rm -f "$sock" "$sock.lock"
pipewire -c /app/audio/pipewire.conf &
pw=$!
trap 'kill "$pw" "${player:-$pw}" 2>/dev/null || true; wait || true' EXIT INT TERM
ready=
for i in $(seq 1 100); do
  if [ -S "$sock" ]; then ready=1; break; fi
  kill -0 "$pw" 2>/dev/null || { echo "container-transport: pipewire exited before creating $sock" >&2; exit 1; }
  sleep .1
done
[ -n "$ready" ] || { echo "container-transport: timed out waiting for pipewire socket" >&2; exit 1; }
# PipeWire defaults its socket to 0755: a different device-worker UID needs
# write access. Only this private volume's fixed control group is admitted.
chgrp "$control_gid" "$sock"
chmod 0660 "$sock"
# Verify the final state of THIS pipewire's socket; never continue with a wrong mode/group.
actual=$(stat -c '%F %g %a' "$sock") || actual=missing
[ "$actual" = "socket $control_gid 660" ] || {
  echo "container-transport: pipewire socket must be a socket, group $control_gid, mode 0660 (found: $actual)" >&2
  exit 1
}
# A no-hardware policy manager provides ordinary client-node linking.
export XDG_STATE_HOME=/tmp/wireplumber-state
export XDG_CACHE_HOME=/tmp/wireplumber-cache
dbus-run-session -- wireplumber &
squeezelite -n "Garage Speakers FILE" -m 02:00:00:00:21:01 \
  -s "${MA_SLIMPROTO_HOST:-music-assistant}:3483" -o garage_music \
  -r 48000-48000 -a 80:4:32:1 &
player=$!
wait "$player"
