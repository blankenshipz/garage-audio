#!/bin/sh
# Symlink the repository's agent skills into local Claude Code and opencode skill
# directories so they track this checkout. Never touches the audio host.
set -eu
repo=$(cd "$(dirname "$0")/.." && pwd)
for dir in "$HOME/.claude/skills" "$HOME/.config/opencode/skills"; do
  mkdir -p "$dir"
  for skill in "$repo"/skills/*/; do
    name=$(basename "$skill")
    target="$dir/$name"
    if [ -e "$target" ] && [ ! -L "$target" ]; then
      echo "skip $target: exists and is not a symlink" >&2
      continue
    fi
    ln -sfn "${skill%/}" "$target"
    echo "linked $target -> ${skill%/}"
  done
done
