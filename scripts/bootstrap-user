#!/usr/bin/env bash
# User-local tools ONLY: never installs host packages or opens audio devices.
set -euo pipefail
cd "$HOME/garage-audio"
test "$(uname -m)" = x86_64
mkdir -p tools state
cd tools
curl -fsSL https://github.com/HEnquist/camilladsp/releases/download/v4.1.3/camilladsp-linux-amd64.tar.gz -o camilla.tar.gz
echo '55f5ec2ed80fcc79a543672f9f89ace4557d290d80584ef31ee0442111bd0b11  camilla.tar.gz' | sha256sum -c -
tar xzf camilla.tar.gz
if ! ldconfig -p | grep -q 'libasound.so.2'; then
  apt download libasound2t64=1.2.15.3-1ubuntu1.1
  echo '96e20cf5c9095ef54ba46fccffea5c01cf2de17a1012c5683a67e43504a6d726  libasound2t64_1.2.15.3-1ubuntu1.1_amd64.deb' | sha256sum -c -
  dpkg-deb -x libasound2t64_1.2.15.3-1ubuntu1.1_amd64.deb libs
fi
curl -fsSL https://bootstrap.pypa.io/get-pip.py -o get-pip.py
echo 'fb24e693bab954209a063d90953621412ccad4a500905a726286e038f508ddf6  get-pip.py' | sha256sum -c -
cd ..
python3 -m venv --without-pip venv
venv/bin/python tools/get-pip.py pip==26.2.1
venv/bin/python -m pip install -r requirements.lock
LD_LIBRARY_PATH="$PWD/tools/libs/usr/lib/x86_64-linux-gnu" tools/camilladsp --version
