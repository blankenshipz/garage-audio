#!/usr/bin/env bash
# User-owned PW monitor bridge; DAC daemon is a separately provisioned UID.
set -euo pipefail
cd "$HOME/garage-audio"
test -p /run/garage-audio/capture.fifo || { echo 'Dedicated DAC daemon/FIFO absent; no same-user DAC fallback'; exit 1; }
test "$(stat -c %U /run/garage-audio/capture.fifo)" = garage-dsp
cleanup() { test -z "${capture:-}" || kill "$capture" 2>/dev/null || true; }
trap cleanup EXIT
# Child only writes permitted raw PCM to DSP FIFO, never opens ALSA hardware.
pw-record --raw --target garage_music --properties='stream.capture.sink=true node.dont-fallback=true node.dont-move=true' --rate 48000 --channels 2 --format f32 - > /run/garage-audio/capture.fifo &
capture=$!
venv/bin/python - <<'PY'
from garage_audio.ipc import request
# initialize/profile share the privileged broker's control.lock and generation.
# Startup ALWAYS resets master and epoch; no user direct websocket access.
request({'cmd':'initialize'})
PY
wait "$capture"
