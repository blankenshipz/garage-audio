#!/usr/bin/env bash
# User-owned PW monitor bridge; DAC daemon is a separately provisioned UID.
set -euo pipefail
cd "$HOME/garage-audio"
test -f state/alsa-device || { echo 'UMC stable identity not commissioned; refusing hardware'; exit 1; }
test -p /run/garage-audio/capture.fifo || { echo 'Dedicated DAC daemon/FIFO absent; no same-user DAC fallback'; exit 1; }
test "$(stat -c %U /run/garage-audio/capture.fifo)" = garage-dsp
cleanup() { test -z "${capture:-}" || kill "$capture" 2>/dev/null || true; }
trap cleanup EXIT
# Child only writes permitted raw PCM to DSP FIFO, never opens ALSA hardware.
pw-record --raw --target garage_music --properties='stream.capture.sink=true node.dont-fallback=true node.dont-move=true' --rate 48000 --channels 2 --format f32 - > /run/garage-audio/capture.fifo &
capture=$!
venv/bin/python - <<'PY'
from garage_audio.profile import load
from garage_audio.control import apply, ROOT
from camilladsp import CamillaClient
from garage_audio.hardware import bound_device
from pathlib import Path
state=ROOT/'state'
p=state/'active-profile.json'
profile=load(p if p.exists() else ROOT/'profiles/uncalibrated.json')
alsa=bound_device(state)
c=CamillaClient('127.0.0.1',1234);c.connect()
try:
    c.volume.set_main_mute(True);c.volume.set_main_volume(-60)
    apply(c,profile,state,alsa)
finally:c.disconnect()
PY
wait "$capture"
