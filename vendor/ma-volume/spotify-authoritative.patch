+async def test_lower_receiver_level_is_applied_before_claim_without_slider_write() -> None:
+    """A fresh 20% report wins over a restored 80% MA player even before its claim."""
+    provider, daemon, set_volume = _policy_provider(80)
+    provider.config.get_value.return_value = "spotify_authoritative"
+    daemon.playing = True
+    player = provider.mass.players.get_player.return_value
+
+    async def apply(_player_id: str, volume: int) -> None:
+        player.state.volume_level = volume
+
+    provider.mass.players.cmd_volume_set = AsyncMock(side_effect=apply)
+    with patch.object(provider, "_schedule_play_media"):
+        await provider._handle_volume_event(daemon, 20)
+        await provider._handle_backend_event(daemon, BackendEvent(BackendEventType.SESSION_ACTIVE))
+    await provider.on_source_selected("player1", "player1", "player1", "stream1")
+    assert player.state.volume_level == 20
+    set_volume.assert_not_awaited()
+
+
+@pytest.mark.parametrize("playing_first", [False, True])
+async def test_device_and_play_order_waits_for_late_volume(playing_first: bool) -> None:
+    """Either event ordering waits for a fresh level before firing the stream."""
+    provider, daemon, set_volume = _policy_provider(80)
+    provider.config.get_value.return_value = "spotify_authoritative"
+    provider.mass.player_queues.play_media = AsyncMock()
+    daemon.audio_source = MagicMock()
+    player = provider.mass.players.get_player.return_value
+
+    async def apply(_player_id: str, volume: int) -> None:
+        player.state.volume_level = volume
+
+    provider.mass.players.cmd_volume_set = AsyncMock(side_effect=apply)
+    events = [BackendEventType.SESSION_ACTIVE, BackendEventType.PLAYING]
+    if playing_first:
+        events.reverse()
+    with patch.object(provider, "_schedule_play_media"):
+        for event_type in events:
+            await provider._handle_backend_event(daemon, BackendEvent(event_type))
+        await provider._deferred_play_media_fire(daemon)
+        provider.mass.player_queues.play_media.assert_not_awaited()
+        await provider._handle_volume_event(daemon, 20)
+        await provider._deferred_play_media_fire(daemon)
+    provider.mass.player_queues.play_media.assert_awaited_once()
+    assert player.state.volume_level == 20
+    set_volume.assert_not_awaited()
+
