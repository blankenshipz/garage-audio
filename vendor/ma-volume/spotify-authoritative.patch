+async def test_echo_grace_and_local_ma_change_never_write_spotify_slider() -> None:
+    """Receiver downchanges are not dropped during the legacy player-wins window."""
+    provider, daemon, set_volume = _policy_provider(80)
+    provider.config.get_value.return_value = "spotify_authoritative"
+    daemon.spotify_session_active = True
