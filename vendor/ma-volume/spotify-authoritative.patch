+@pytest.mark.parametrize("volume", [0, 1, 10, 20, 50, 100])
+async def test_compensation_remains_cubic_inverse_and_follows_adoption(volume: int) -> None:
+    """Static headroom algebra and mute/adopt/unmute ordering, not measured audio."""
+    backend, _events = _policy_backend()
+    sink = _FakeSink()
+    backend._sink = sink
+    backend._client = MagicMock()
+    backend._client.set_volume = AsyncMock()
+
+    async def adopted(_event_data: BackendEvent) -> None:
+        assert sink.volumes == [0]
+
+    backend._event_callback = adopted
+    await backend._handle_event(_volume_event(volume))
+    expected = 0 if volume == 0 else round(10000 / volume, 2)
+    assert sink.volumes == [0, expected]
+    if volume:
+        # Pulse software gain and Spotify attenuation both use a cubic curve.
+        assert (volume / 100) ** 3 * (expected / 100) ** 3 == pytest.approx(1, rel=0.001)
+    backend._client.set_volume.assert_not_awaited()
+
