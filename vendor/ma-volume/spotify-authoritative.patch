+async def test_inactive_snapshot_cannot_authorize_later_activation() -> None:
+    """Inactive volume is only a candidate; activation needs a fresh active snapshot."""
+    backend, events = _policy_backend()
+    sink = _FakeSink()
+    backend._sink = sink
+    backend._client = MagicMock()
+    backend._client.get_state = AsyncMock()
+    backend._client.set_volume = AsyncMock()
+    await backend._handle_event(_event("device_changed", SoloistDeviceChanged(is_active=False)))
+    await backend._handle_event(
+        _event("playback_state", SoloistPlaybackState(status="paused", volume=80, is_active=False))
+    )
+    await backend._handle_event(_event("device_changed", SoloistDeviceChanged(is_active=True)))
+    assert not [event for event in events if event.type is BackendEventType.VOLUME]
+    assert all(volume == 0 for volume in sink.volumes)
+    backend._client.get_state.assert_awaited_once()
+    await backend._handle_event(
+        _event("playback_state", SoloistPlaybackState(status="playing", volume=20, is_active=True))
+    )
+    assert [event.volume for event in events if event.type is BackendEventType.VOLUME] == [20]
+    assert sink.volumes[-1] == 500
+    backend._client.set_volume.assert_not_awaited()
