+    backend._sink = sink
+    backend._recover_sink = AsyncMock()
+    backend._event_callback = AsyncMock(side_effect=AudioError("readback failed"))
+    await backend._handle_event(_volume_event(20))
+    assert sink.volumes == [0]
+    backend._recover_sink.assert_awaited_once()
