+from music_assistant.providers.spotify_connect.provider import CONF_BACKEND, CONF_VOLUME_MODE
+from music_assistant.providers.spotify_connect.soloist.backend import SoloistBackend
+from music_assistant.providers.spotify_connect.soloist.runtime import (
+    SoloistAuthState,
+    SoloistDeviceChanged,
+    SoloistPlaybackState,
+)
+from tests.providers.spotify_connect.test_provider import (
+    _make_daemon,
+    _provider_with_stored_config,
+    _volume_sync_provider,
+)
