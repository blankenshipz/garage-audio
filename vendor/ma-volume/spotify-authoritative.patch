+@pytest.mark.parametrize(
+    "event_type", [BackendEventType.SESSION_INACTIVE, BackendEventType.CONNECTION_LOST]
+)
+async def test_session_loss_invalidates_volume(event_type: BackendEventType) -> None:
+    """A replacement/reconnect cannot reuse the last account's level."""
+    provider, daemon, set_volume = _policy_provider(20)
+    provider.config.get_value.return_value = "spotify_authoritative"
+    daemon.receiver_volume = 20
+    with patch.object(provider, "_schedule_play_media"):
+        await provider._handle_backend_event(daemon, BackendEvent(event_type))
+        await provider._handle_backend_event(daemon, BackendEvent(BackendEventType.SESSION_ACTIVE))
+    daemon.playing = True
+    with pytest.raises(AudioError, match="volume"):
+        await provider.on_source_selected("player1", "player1", "player1", "stream2")
+    set_volume.assert_not_awaited()
+
+
+async def test_pause_keeps_volume_for_resume() -> None:
+    """A pause is not an account/session boundary."""
+    provider, daemon, _set_volume = _policy_provider(20)
