+def _policy_provider(volume: int) -> tuple[Any, Any, AsyncMock]:
+    """Build an authoritative provider with dynamically configured test doubles."""
+    provider: Any
+    provider, daemon, set_volume = _volume_sync_provider(volume)
+    provider.config.get_value.return_value = "spotify_authoritative"
+    provider.get_setup_value = MagicMock(return_value="soloist")
+    return provider, daemon, set_volume
+
+
+def _policy_backend() -> tuple[Any, list[BackendEvent]]:
+    """Build an authoritative backend with dynamically configured test doubles."""
+    backend: Any
+    backend, events = _make_backend(volume_mode="spotify_authoritative")
+    backend._receiver_session_active = True
+    backend._receiver_volume_confirmed = True
+    return backend, events
+
+
+@pytest.mark.parametrize(
+    ("backend_choice", "mode", "expected_mode"),
+    [
+        ("soloist", "spotify_authoritative", "spotify_authoritative"),
+        ("go_librespot", "spotify_authoritative", "player_only"),
+        (None, "spotify_authoritative", "player_only"),
+        ("soloist", "player_only", "player_only"),
+        ("soloist", "sync_spotify", "sync_spotify"),
+        (None, None, "player_only"),
+        ("go_librespot", "sync_spotify", "sync_spotify"),
+    ],
+)
+def test_backend_construction_uses_stored_choice_without_dev_only_property(
+    tmp_path: Path,
+    backend_choice: str | None,
+    mode: str | None,
+    expected_mode: str,
+) -> None:
+    """Construct the complete provider's backend with real stored-config accessors."""
+    setup_data = {CONF_BACKEND: backend_choice} if backend_choice is not None else {}
+    provider = _provider_with_stored_config(setup_data, tmp_path)
+    if mode is not None:
+        provider.config.values[CONF_VOLUME_MODE] = ConfigEntry(
+            key=CONF_VOLUME_MODE, type=ConfigEntryType.STRING, value=mode
+        )
+    backend = provider._create_backend(_make_daemon(), "Test Player")
+    assert provider._resolve_volume_mode() == expected_mode
+    if backend_choice == "soloist":
+        assert isinstance(backend, SoloistBackend)
+        assert backend._volume_mode == expected_mode
+    else:
+        assert isinstance(backend, GoLibrespotBackend)
+
