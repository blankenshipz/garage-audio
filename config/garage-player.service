[Unit]
Description=Garage Speakers Squeezelite (sole MA transport)
Requires=garage-wireplumber.service
After=garage-wireplumber.service
[Service]
Environment=PIPEWIRE_RUNTIME_DIR=%t/garage-audio
Environment=PIPEWIRE_REMOTE=garage-pipewire
Environment=ALSA_CONFIG_PATH=%h/garage-audio/config/asound.conf
WorkingDirectory=%h/garage-audio
ExecStart=/usr/bin/squeezelite -n "Garage Speakers" -m 02:00:00:00:21:01 -s 127.0.0.1:3483 -o garage_music -r 48000-48000 -a 80:4:32:1
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
