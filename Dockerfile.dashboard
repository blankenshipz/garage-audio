ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY vendor/dsp /opt/garage-audio/dsp/vendor
RUN cd /opt/garage-audio/dsp/vendor \
 && sha256sum -c SHA256SUMS \
 && mkdir -p /opt/garage-audio/dsp/lib /tmp/dsp-unpack /tmp/alsa-unpack \
 && tar xzf camilladsp-linux-amd64-v4.1.3.tar.gz -C /tmp/dsp-unpack camilladsp \
 && echo 'e69090287d9af87eeb5720d59cf8ebf8cab1ed3adbe24de1dd60b66a47f5385b  /tmp/dsp-unpack/camilladsp' | sha256sum -c - \
 && dpkg-deb -x libasound2_1.2.8-1+b1_amd64.deb /tmp/alsa-unpack \
 && echo '9dabddc79cc29b4f69058ac7d94ac11e82a4d6d8cc8c9148cb8377705790c7ea  /tmp/alsa-unpack/usr/lib/x86_64-linux-gnu/libasound.so.2.0.0' | sha256sum -c - \
 && cp /tmp/dsp-unpack/camilladsp /opt/garage-audio/dsp/camilladsp \
 && cp /tmp/alsa-unpack/usr/lib/x86_64-linux-gnu/libasound.so.2.0.0 /opt/garage-audio/dsp/lib/libasound.so.2 \
 && chmod 0555 /opt/garage-audio/dsp/camilladsp \
 && chmod 0444 /opt/garage-audio/dsp/lib/libasound.so.2 \
 && chown -R root:root /opt/garage-audio/dsp \
 && chmod -R go-w /opt/garage-audio/dsp \
 && test "$(LD_LIBRARY_PATH=/opt/garage-audio/dsp/lib /opt/garage-audio/dsp/camilladsp --version)" = 'CamillaDSP 4.1.3 (05e9cfc)' \
 && rm -rf /tmp/dsp-unpack /tmp/alsa-unpack
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY garage_audio /app/garage_audio
COPY profiles /app/profiles
COPY web /app/web
USER 1000:1000
EXPOSE 8098
CMD ["python", "-m", "garage_audio.webserver"]
