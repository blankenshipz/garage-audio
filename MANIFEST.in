include LICENSE THIRD_PARTY_NOTICES.md README.md pyproject.toml MANIFEST.in
include requirements.txt requirements.lock .env.example .dockerignore
include Dockerfile* compose*.yaml API_CONTRACT*.md
recursive-include garage_audio *.py
recursive-include ma_provider *.py *.json *.md
recursive-include profiles *.json
recursive-include web *.html *.js *.css *.svg *.json *.md
recursive-include docs *.md
recursive-include config *.json *.yaml *.yml *.conf *.lua *.service *.socket *.tmpfiles
recursive-include scripts *
recursive-include vendor *
recursive-include tests *.py *.sh *.yaml *.cjs
recursive-include research *.py *.md *.txt *.json
recursive-include .github *.yml
prune state
prune secrets
prune tools
prune venv
prune .venv
prune build
prune dist
global-exclude __pycache__ *.py[cod] .DS_Store .env *.raw *.wav opencode.json
