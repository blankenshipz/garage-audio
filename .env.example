# Copy to .env locally. No credentials here. Absolute persistent paths only.
# Compose defaults preserve the existing installation; these are portable examples.
GARAGE_MA_STATE_DIR=/srv/garage-audio/state/ma
GARAGE_MUSIC_DIR=/srv/garage-audio/state/music
GARAGE_DASHBOARD_DATA_DIR=/srv/garage-audio/state/dashboard/data
GARAGE_DASHBOARD_AUTH_DIR=/srv/garage-audio/state/dashboard/auth
# Set the actual trusted LAN host IP, distinct from loopback (published separately).
GARAGE_LAN_IP=192.0.2.10
GARAGE_APP_AUTHORITIES=127.0.0.1:8098,localhost:8098,192.0.2.10:8098
GARAGE_TRUSTED_LAN_AUTHORITY=192.0.2.10:8098
# Use reviewed matching immutable image digests. Never paste credentials here.
# DASHBOARD_IMAGE=your-registry/garage-audio-dashboard@sha256:REVIEWED_DIGEST
# AUDIO_IMAGE=your-registry/garage-audio-audio@sha256:REVIEWED_DIGEST
